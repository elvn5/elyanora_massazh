# Copy to .env; generate both secrets, e.g. openssl rand -hex 24.
# Use hex/alphanumeric POSTGRES_PASSWORD (it is used in a connection URL).
POSTGRES_PASSWORD=
# Local development only. In production CD reads the ADMIN_PASSWORD GitHub Secret.
ADMIN_PASSWORD=
PUBLIC_URL=http://localhost:8088
WEB_BIND=127.0.0.1
WEB_PORT=8088
SALON_TIMEZONE=Asia/Bishkek
CURRENCY=KGS
# Local development only. In production CD reads the GitHub Secret of the same name.
TELEGRAM_BOT_TOKEN=
# Telegram supergroup topic where new booking cards are sent.
TELEGRAM_BOOKINGS_CHAT_ID=-1003761508539
TELEGRAM_BOOKINGS_THREAD_ID=2
