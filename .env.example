# Copy to .env; generate both secrets, e.g. openssl rand -hex 24.
# Use hex/alphanumeric POSTGRES_PASSWORD (it is used in a connection URL).
POSTGRES_PASSWORD=
ADMIN_PASSWORD=
PUBLIC_URL=http://localhost:8088
WEB_BIND=127.0.0.1
WEB_PORT=8088
SALON_TIMEZONE=Asia/Bishkek
CURRENCY=KGS
# Local development only. In production CD reads the GitHub Secret of the same name.
TELEGRAM_BOT_TOKEN=
