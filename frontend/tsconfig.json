{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "dom"
    ],
    "paths": {
      "@spartan-ng/helm/utils": [
        "./src/ui/utils/src/index.ts"
      ],
      "@spartan-ng/helm/button": [
        "./src/ui/button/src/index.ts"
      ],
      "@spartan-ng/helm/badge": [
        "./src/ui/badge/src/index.ts"
      ],
      "@spartan-ng/helm/card": [
        "./src/ui/card/src/index.ts"
      ],
      "@spartan-ng/helm/input": [
        "./src/ui/input/src/index.ts"
      ],
      "@spartan-ng/helm/textarea": [
        "./src/ui/textarea/src/index.ts"
      ],
      "@spartan-ng/helm/label": [
        "./src/ui/label/src/index.ts"
      ],
      "@spartan-ng/helm/select": [
        "./src/ui/select/src/index.ts"
      ],
      "@spartan-ng/helm/switch": [
        "./src/ui/switch/src/index.ts"
      ],
      "@spartan-ng/helm/checkbox": [
        "./src/ui/checkbox/src/index.ts"
      ],
      "@spartan-ng/helm/table": [
        "./src/ui/table/src/index.ts"
      ],
      "@spartan-ng/helm/alert": [
        "./src/ui/alert/src/index.ts"
      ],
      "@spartan-ng/helm/alert-dialog": [
        "./src/ui/alert-dialog/src/index.ts"
      ],
      "@spartan-ng/helm/field": [
        "./src/ui/field/src/index.ts"
      ],
      "@spartan-ng/helm/separator": [
        "./src/ui/separator/src/index.ts"
      ],
      "@spartan-ng/helm/input-group": [
        "./src/ui/input-group/src/index.ts"
      ],
      "@spartan-ng/helm/empty": [
        "./src/ui/empty/src/index.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
